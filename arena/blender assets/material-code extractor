import bpy
from bpy.props import *

def safe_name(name):
    """Return a Python-safe variable name from a node name."""
    import re
    name = re.sub(r'[^a-zA-Z0-9_]', '_', name)
    if not name[0].isalpha():
        name = 'n_' + name
    return name

def node_tree_to_code(ntree, ntree_varname, indent=0, group_tree_collector=None):
    """
    Generate Python code that recreates the node tree.
    ntree        : the node tree (material.node_tree or a node group tree)
    ntree_varname: string, name of the variable holding the node tree in generated code
    indent       : base indentation level
    group_tree_collector : list to collect code for node groups (used recursively)
    Returns: str (the code block)
    """
    lines = []
    sp = '    ' * indent  # indent string

    # Node counter for unique variable naming
    node_var_names = {}
    # Build a name for each node
    for node in ntree.nodes:
        base = safe_name(node.name)
        # Ensure uniqueness
        i = 1
        name = base
        while name in node_var_names.values():
            name = f"{base}_{i}"
            i += 1
        node_var_names[node] = name

    # Create nodes
    lines.append(f"{sp}nodes = {ntree_varname}.nodes")
    lines.append(f"{sp}links = {ntree_varname}.links")
    lines.append(f"{sp}nodes.clear()")  # clear default nodes

    # We'll need to create group nodes later, collect group trees first
    if group_tree_collector is None:
        group_tree_collector = []

    for node in ntree.nodes:
        var = node_var_names[node]
        # Create the node
        lines.append(f"{sp}{var} = nodes.new(type='{node.bl_idname}')")
        lines.append(f"{sp}{var}.name = {repr(node.name)}")
        lines.append(f"{sp}{var}.location = {tuple(node.location)}")
        if node.hide:
            lines.append(f"{sp}{var}.hide = True")
        if node.label:
            lines.append(f"{sp}{var}.label = {repr(node.label)}")
        if hasattr(node, 'width'):
            lines.append(f"{sp}{var}.width = {node.width}")

        # Set all custom properties (except special ones)
        skip_props = {'rna_type', 'type', 'inputs', 'outputs', 'internal_links',
                      'parent', 'node_tree', 'location', 'name', 'hide',
                      'label', 'width', 'color', 'dimensions',
                      'bl_idname', 'bl_label', 'bl_icon', 'bl_static_type',
                      'draw_buttons', 'shading_compat', 'register', 'id_data'}
        for p in node.bl_rna.properties:
            if p.identifier in skip_props or p.is_readonly or p.is_hidden:
                continue
            try:
                val = getattr(node, p.identifier)
            except AttributeError:
                continue
            # Skip if it's a node tree (handled separately for group nodes)
            if isinstance(val, bpy.types.NodeTree):
                # Collect group tree for later creation
                if val and val not in [g['tree'] for g in group_tree_collector]:
                    group_tree_collector.append({'tree': val, 'varname': f"group_{safe_name(val.name)}"})
                continue
            # Skip socket collections
            if p.type == 'COLLECTION' and any(
                    'Socket' in s.__name__ for s in p.srna.property_classes if hasattr(s, '__name__')):
                continue
            # Write setattr
            val_repr = repr(val)
            lines.append(f"{sp}{var}.{p.identifier} = {val_repr}")

        # Set default values for unlinked inputs
        for inp in node.inputs:
            if not inp.is_linked and hasattr(inp, 'default_value'):
                # Determine the attribute name
                default_val = inp.default_value
                if isinstance(default_val, bpy.types.bpy_prop_array):
                    # Convert to tuple for code
                    lines.append(f"{sp}{var}.inputs[{repr(inp.name)}].default_value = {tuple(default_val)}")
                else:
                    lines.append(f"{sp}{var}.inputs[{repr(inp.name)}].default_value = {repr(default_val)}")

    # Links
    for link in ntree.links:
        from_node_var = node_var_names[link.from_node]
        to_node_var = node_var_names[link.to_node]
        from_socket_name = link.from_socket.name
        to_socket_name = link.to_socket.name
        lines.append(
            f"{sp}links.new({from_node_var}.outputs[{repr(from_socket_name)}], "
            f"{to_node_var}.inputs[{repr(to_socket_name)}])"
        )

    # If this is a node group tree, we must also define its interface
    # (Group Input/Output sockets)
    if isinstance(ntree, bpy.types.NodeTree) and ntree.bl_idname == 'ShaderNodeTree':
        # Group trees have inputs/outputs (interface)
        if hasattr(ntree, 'inputs'):
            for inp in ntree.inputs:
                # We already have Group Input nodes, their sockets are auto-generated.
                # But we need to set the interface. So we add lines after clearing nodes
                # Actually we inserted nodes.clear() above, so we must set interface before
                # adding nodes. So we'll restructure: First clear, set interface, then add nodes.
                pass  # We'll handle this differently

    return "\n".join(lines), group_tree_collector

